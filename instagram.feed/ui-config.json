{
	"inputs": [
		{
			"name": "handle",
			"type": "text",
			"prompt": "Instagram Handle",
			"placeholder": "natgeo"
		},
		{
			"name": "contentFilter",
			"type": "choices",
			"prompt": "Content Filter",
			"value": "all",
			"placeholder": "Choose which types of posts to show",
			"choices": [
				{
					"value": "all",
					"display_name": "All Posts"
				},
				{
					"value": "images",
					"display_name": "Images Only"
				},
				{
					"value": "videos",
					"display_name": "Videos Only"
				},
				{
					"value": "carousels",
					"display_name": "Carousels Only"
				},
				{
					"value": "images_carousels",
					"display_name": "Images & Carousels"
				},
				{
					"value": "videos_carousels",
					"display_name": "Videos & Carousels"
				}
			]
		},
		{
			"name": "useSessionId",
			"type": "switch",
			"prompt": "Use Session ID",
			"value": "off",
			"placeholder": "When enabled, the session ID below will be sent with requests to reduce rate limiting"
		},
		{
			"name": "sessionid",
			"type": "text",
			"prompt": "Session ID",
			"placeholder": "From browser DevTools → Cookies → sessionid",
			"value": "your-session-id-here"
		},
		{
			"name": "debug",
			"type": "switch",
			"prompt": "Debug Mode",
			"value": "off",
			"placeholder": "When enabled, debug information will be logged to the console"
		}
	]
}
